pipeline {
    agent any
    options { buildDiscarder(logRotator(numToKeepStr: '5')) }
    environment {
        // change riya-sharma to your own prefix
        DEMO_TOKEN = credentials('aditya-demo-token')
    }
    stages {
        stage('Use the secret') {
            steps {
                sh 'echo "The token is: $DEMO_TOKEN"'
                sh 'echo "Token length: ${#DEMO_TOKEN} characters"'
                sh 'test -n "$DEMO_TOKEN" && echo "Secret is available to this stage"'
            }
        }
        stage('Bind only where needed') {
            steps {
                withCredentials([string(credentialsId: 'aditya-demo-token',
                    variable: 'TOKEN')]) {
                    sh 'echo "Inside withCredentials: $TOKEN"'
                }
                sh 'echo "Outside the block TOKEN is: [${TOKEN:-not set}]"'
            }
        }
        stage('The wrong way') {
            steps {
                // double quotes: Groovy pastes the secret into the command
                sh "echo Interpolated by Groovy: ${DEMO_TOKEN}"
            }
        }
    }
}
