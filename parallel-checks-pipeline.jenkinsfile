pipeline {
    agent none
    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }
    stages {
        stage('CI') {
            agent any
            stages {
                stage('Build') {
                    steps {
                        sh 'mkdir -p dist'
                        sh 'echo "<h1>Hello Jenkins</h1>" > dist/index.html'
                        stash name: 'site', includes: 'dist/**'
                    }
                }
                stage('Quality checks') {
                    failFast true
                    parallel {
                        stage('HTML test') {
                            steps {
                                sh 'grep -q "Hello Jenkins" dist/index.html && echo "HTML OK"'
                            }
                        }
                        stage('Size check') {
                            steps {
                                sh 'test $(wc -c < dist/index.html) -lt 10000 && echo "Size OK"'
                            }
                        }
                        stage('Lint') {
                            steps {
                                sh 'grep -q "<h1>" dist/index.html && echo "Lint OK"'
                            }
                        }
                    }
                }
            }
        }
        stage('Release') {
            input {
                message 'Release this build?'
                ok 'Approve'
                parameters {
                    string(name: 'APPROVER_NOTE', defaultValue: 'Looks good',
                        description: 'Why are you approving?')
                }
            }
            agent any
            steps {
                unstash 'site'
                echo "Approved with note: ${APPROVER_NOTE}"
                archiveArtifacts artifacts: 'dist/**'
            }
        }
    }
    post {
        aborted { echo 'Release was not approved' }
        success { echo "Build ${BUILD_NUMBER} released" }
    }
}
